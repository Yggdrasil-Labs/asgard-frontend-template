{
  "name": "asgard-frontend-template",
  "type": "module",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "type-check": "pnpm build && vue-tsc --noEmit -p tsconfig.app.json",
    "dep:check": "pnpm dlx npm-check-updates",
    "dep:update": "pnpm dlx npm-check-updates -u && pnpm install",
    "prepare": "husky"
  },
  "dependencies": {
    "@vue/shared": "3.5.44",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "element-plus": "^2.14.5",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/ep": "^1.2.4",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "modern-normalize": "^3.0.1",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "overrides": {
      "defu": ">=6.1.5",
      "form-data": ">=4.0.6",
      "happy-dom": ">=20.8.9",
      "immutable": "5.1.8",
      "lodash": ">=4.18.0",
      "micromark-extension-math@3.1.0>katex": "0.18.2",
      "nanoid": "3.3.18",
      "oxfmt@0.35.0>tinypool": "2.1.2",
      "picomatch": ">=4.0.4"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,json,md,yml}": "eslint --fix",
    "*.{test,spec}.{ts,tsx,vue,js}": "eslint --fix"
  }
}
