{
  "name": "asgard-frontend-template",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "dep:check": "pnpm dlx npm-check-updates",
    "dep:update": "pnpm dlx npm-check-updates -u && pnpm install",
    "prepare": "husky"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "element-plus": "^2.14.6",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/ep": "^1.2.4",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "modern-normalize": "^3.0.1",
    "sass": "^1.104.1",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^5.0.0": "5.0.9",
      "defu": ">=6.1.5",
      "fast-uri": "3.1.6",
      "form-data": ">=4.0.6",
      "happy-dom": ">=20.8.9",
      "immutable": "5.1.8",
      "js-yaml": "4.3.1",
      "lodash": ">=4.18.0",
      "nanoid": "3.3.18",
      "picomatch": ">=4.0.4",
      "postcss": "8.5.23"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,json,md,yml}": "eslint --fix",
    "*.{test,spec}.{ts,tsx,vue,js}": "eslint --fix"
  }
}
