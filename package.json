{
  "name": "asgard-frontend-template",
  "type": "module",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "preview:test": "vite preview --mode test",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "dep:check": "pnpm dlx npm-check-updates",
    "dep:update": "pnpm dlx npm-check-updates -u && pnpm install",
    "prepare": "husky",
    "stylelint": "stylelint \"src/**/*.{vue,scss}\" --max-warnings=0",
    "jscpd": "jscpd",
    "depcruise": "node scripts/check-dependencies.mjs",
    "knip": "knip",
    "test:coverage": "vitest run --coverage",
    "types:check": "node scripts/check-generated-types.mjs",
    "types:generate": "node scripts/check-generated-types.mjs --write",
    "test:engineering": "node --test tests/engineering/*.test.mjs",
    "check": "pnpm lint:fix && pnpm type-check",
    "check:full": "pnpm lint && pnpm type-check && pnpm stylelint && pnpm jscpd && pnpm depcruise && pnpm knip && pnpm test:coverage && pnpm types:check && pnpm test:engineering"
  },
  "dependencies": {
    "@vue/shared": "3.5.46",
    "@vueuse/core": "^15.1.0",
    "axios": "^1.21.1",
    "element-plus": "^2.14.9",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.24",
    "vue-router": "^5.5.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/ep": "^1.2.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vue/compiler-sfc": "3.5.46",
    "@vue/tsconfig": "^0.9.1",
    "dependency-cruiser": "18.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.16.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-sonarjs": "4.2.3",
    "husky": "^9.1.7",
    "jscpd": "5.4.3",
    "jsdom": "^31.0.1",
    "knip": "6.49.0",
    "lint-staged": "^17.6.3",
    "modern-normalize": "^3.0.1",
    "postcss": "8.5.34",
    "postcss-html": "2.0.1",
    "postcss-scss": "4.0.9",
    "sass": "^1.108.2",
    "stylelint": "18.1.0",
    "stylelint-config-standard-scss": "18.0.0",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "micromark-extension-math@3.1.0>katex": "0.18.2",
      "oxfmt@0.35.0>tinypool": "2.1.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.vue": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "stylelint --fix"
    ],
    "*.{scss,css}": "stylelint --fix"
  }
}
