# ===========================================
# 环境变量配置示例文件
# ===========================================
# 复制此文件为 .env 并根据需要修改配置值
# 注意：所有环境变量必须以 VITE_ 开头才能在客户端访问

# ===========================================
# 应用基础配置
# ===========================================

# 应用名称
# 显示在页面标题和界面中
VITE_APP_NAME=Asgard Frontend

# 开发服务器端口（可选，默认 5173）
VITE_PORT=5173

# ===========================================
# API 配置
# ===========================================

# API 基础地址（只到 origin，不包含 /api 前缀）
# 接口路径统一自带 /api 前缀（如 /api/customers），最终请求为
# ${VITE_API_BASE_URL}/api/customers
# 开发环境示例：http://localhost:8080
# 测试环境示例：https://test-api.example.com
# 生产环境示例：https://api.example.com
#
# 注意：生产环境必须显式提供该变量，缺失时构建产物会在加载期报错（fail-closed）。
VITE_API_BASE_URL=http://localhost:8080

# ===========================================
# 环境说明
# ===========================================
# 
# 开发环境 (development):
# - VITE_API_BASE_URL=http://localhost:8080
# 
# 测试环境 (test):
# - VITE_API_BASE_URL=https://test-api.example.com
# 
# 生产环境 (production):
# - VITE_API_BASE_URL=https://api.example.com
# 
# ===========================================
# 注意事项
# ===========================================
# 
# 1. 所有环境变量必须以 VITE_ 开头
# 2. 修改环境变量后需要重启开发服务器
# 3. 生产环境部署时，必须设置 VITE_API_BASE_URL（缺失会构建/加载失败）
# 4. 敏感信息（如 API 密钥）不应放在客户端环境变量中
# 5. 环境变量值不要包含引号，除非引号是值的一部分
# 6. E2E 测试已迁移至独立仓库 bifrost-e2e，相关配置请见该仓库
